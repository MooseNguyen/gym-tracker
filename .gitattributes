# Line endings: LF in the repo and in every working tree, whatever the
# local core.autocrlf says, so Windows checkouts stop showing files as
# modified when only the line endings differ.
* text=auto eol=lf

# Binary assets: never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
