# Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: error reporting (Sentry project settings -> Client Keys (DSN)).
# Public by design, like the anon key: it can only send events. Leave it empty
# in local dev; on Vercel, also set SENTRY_AUTH_TOKEN, SENTRY_ORG and
# SENTRY_PROJECT (build-time only, never VITE_-prefixed). See the README.
VITE_SENTRY_DSN=
